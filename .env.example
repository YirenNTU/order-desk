# 複製成 .env 後填這台電腦自己的永豐資料。不要把填好的 .env 傳到 GitHub。

# API Key 和 Secret Key，從永豐 API 後台取得。
SJ_API_KEY=
SJ_SEC_KEY=

# 證券帳號，只填帳號數字，例如 0574497。正式下單必填。模擬可以留空。
SJ_ACCOUNT_ID=

# 正式下單時，把下一行改成 YES_I_ACCEPT_REAL_ORDERS
# 模擬或只看預覽時保持空白。
TRADING_ALLOW_PRODUCTION=

# 憑證 .pfx 的完整路徑。正式下單必填。Keychain 不能代替這個路徑。
# 例：/Users/yourname/Desktop/Sinopac.pfx
SJ_CA_PATH=

# 憑證密碼。下載憑證時若沒有另外設定，通常是身分證字號，英文字母大寫。
SJ_CA_PASSWD=
